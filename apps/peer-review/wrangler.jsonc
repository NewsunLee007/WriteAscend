{
 "name":"newsun-writing-peer",
 "main":"worker/index.ts",
 "compatibility_date":"2026-10-16",
 "assets":{"directory":"dist","binding":"ASSETS","not_found_handling":"single-page-application","run_worker_first":["/api/*"]},
 "env":{"development":{
  "name":"newsun-writing-peer-development",
  "vars":{"PUBLIC_ORIGIN":"http://127.0.0.1:8793","DAILY_ORIGIN":"http://127.0.0.1:8890"},
  "d1_databases":[{"binding":"DB","database_name":"writing-peer-local-qa","database_id":"00000000-0000-4000-8000-000000000099","migrations_dir":"migrations"}]
 }}
}
