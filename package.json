{
  "name": "writeascend",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --import tsx --test test/*.test.ts",
    "worker:dev": "wrangler dev --env development",
    "worker:check": "tsc --noEmit -p tsconfig.worker.json && wrangler deploy --env staging --dry-run",
    "deploy:staging": "npm run build && wrangler deploy --env staging",
    "peer:test": "npm --prefix apps/peer-review test",
    "peer:check": "npm --prefix apps/peer-review run check",
    "test:all": "npm test && npm run peer:test",
    "worker:check:production": "tsc --noEmit -p tsconfig.worker.json && wrangler deploy --env production --dry-run"
  },
  "dependencies": {
    "jsqr": "^1.4.0",
    "jszip": "^3.10.2",
    "lucide-react": "^1.58.0",
    "mammoth": "^1.13.0",
    "pdfjs-dist": "^6.4.299",
    "pinyin-pro": "^3.29.5",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261016.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "pngjs": "^5.0.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "wrangler": "^4.151.0"
  }
}
