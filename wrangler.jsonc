{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "writeascend-local",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-16",
  "workers_dev": false,
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true
  },
  "env": {
    "development": {
      "name": "writeascend-development",
      "vars": {
        "PUBLIC_ORIGIN": "http://127.0.0.1:8789",
        "DAILY_ORIGIN": "http://127.0.0.1:8890"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "writeascend-development",
          "database_id": "local-writeascend",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "FILES",
          "bucket_name": "writeascend-development-private"
        }
      ],
      "queues": {
        "producers": [
          {
            "binding": "MODEL_JOBS",
            "queue": "writeascend-development-model-jobs"
          },
          {
            "binding": "FEEDBACK_EVENTS",
            "queue": "writeascend-development-feedback-events"
          }
        ],
        "consumers": [
          {
            "queue": "writeascend-development-model-jobs",
            "max_batch_size": 1,
            "max_batch_timeout": 1,
            "max_retries": 3,
            "max_concurrency": 2
          },
          {
            "queue": "writeascend-development-feedback-events",
            "max_batch_size": 5,
            "max_batch_timeout": 1,
            "max_retries": 3,
            "max_concurrency": 3
          }
        ]
      },
      "triggers": {
        "crons": [
          "* * * * *"
        ]
      },
      "version_metadata": {
        "binding": "VERSION"
      }
    },
    "staging": {
      "name": "writeascend-staging",
      "workers_dev": true,
      "preview_urls": false,
      "vars": {
        "PUBLIC_ORIGIN": "https://writeascend-staging.317792050.workers.dev",
        "DAILY_ORIGIN": "https://daily.newsunenglish.com",
        "PEER_ORIGIN": "https://newsun-writing-peer-staging.317792050.workers.dev",
        "MODEL_VAULT_KEY_ID": "staging-personal-v1"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "writeascend-staging",
          "database_id": "c1bb77de-0b5f-4d35-8dbf-e52739c3ba75",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "FILES",
          "bucket_name": "writeascend-staging-private"
        }
      ],
      "queues": {
        "producers": [
          {
            "binding": "MODEL_JOBS",
            "queue": "writeascend-staging-model-jobs"
          },
          {
            "binding": "FEEDBACK_EVENTS",
            "queue": "writeascend-staging-feedback-events"
          }
        ],
        "consumers": [
          {
            "queue": "writeascend-staging-model-jobs",
            "max_batch_size": 1,
            "max_batch_timeout": 1,
            "max_retries": 3,
            "max_concurrency": 2
          },
          {
            "queue": "writeascend-staging-feedback-events",
            "max_batch_size": 5,
            "max_batch_timeout": 1,
            "max_retries": 3,
            "max_concurrency": 3
          }
        ]
      },
      "triggers": {
        "crons": [
          "* * * * *"
        ]
      },
      "services": [
        {
          "binding": "PEER_SERVICE",
          "service": "newsun-writing-peer-staging"
        }
      ],
      "version_metadata": {
        "binding": "VERSION"
      }
    }
  },
  "account_id": "41c0024342aae8d7b6a8b67c7def1d3e"
}
